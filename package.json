{
  "name": "tokai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"pnpm --filter @tokai/api start\" \"pnpm --filter @tokai/web dev\"",
    "dev:web": "pnpm --filter @tokai/web dev",
    "dev:api": "pnpm --filter @tokai/api dev",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p convex/tsconfig.json",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "verify:tutor": "tsx scripts/verify-tutor.ts",
    "verify:teaching": "tsx scripts/verify-teaching.ts",
    "verify:speech": "tsx scripts/verify-speech.ts",
    "assets:sync": "tsx scripts/sync-mediapipe-assets.ts --sync",
    "assets:check": "tsx scripts/sync-mediapipe-assets.ts --check",
    "models:sync": "tsx scripts/sync-learning-assets.ts",
    "models:check": "tsx scripts/sync-learning-assets.ts --check",
    "local:convex": "convex dev --tail-logs disable",
    "local:setup": "tsx infra/local/setup.ts",
    "local:identity": "tsx infra/local/start-identity.ts",
    "verify:local-learning": "tsx scripts/verify-local-learning.ts",
    "verify:grounding": "tsx scripts/verify-grounding.ts",
    "eval:tutor": "tsx scripts/evaluate-learning.ts",
    "verify:capacity": "tsx scripts/verify-capacity.ts",
    "verify:restore": "tsx scripts/verify-restore.ts",
    "build:native": "tsx infra/deploy/build-api.ts",
    "verify:native": "tsx infra/deploy/verify-native.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "@vercel/nft": "1.11.0",
    "concurrently": "9.2.1",
    "convex": "1.49.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vercel": "65.10.0",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.7",
    "better-auth": "1.6.34"
  }
}
