# Phase 1 works without provider credentials in clearly labeled sample mode.
# Copy this file to .env in F:/mili. Never commit .env.
API_PORT=4000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Isolated compatibility/test file mode only; full local mode uses Convex.
# TOKAI_DATA_DIR=F:/mili/.tokai

# Live text and voice. Keep both keys server-side.
GEMINI_API_KEY=
# Choose a model your account supports; validate with the explicit live probe.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional image-understanding override; defaults to GEMINI_MODEL.
# VISION_MODEL=gemini-3.5-flash-lite
# Low-latency tutor turns. Tried in TUTOR_PROVIDER_ORDER before Gemini, which stays the fallback.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TUTOR_PROVIDER_ORDER=cerebras,groq
# Per fast-provider budget before falling back (ms).
TUTOR_FAST_TIMEOUT_MS=12000
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_VOICE_ID=aai-audrey
ASSEMBLYAI_STT_MODEL=universal-3-6-pro

# Full local infrastructure: generated by infra/local/setup.ts into ignored .env.local.
# CONVEX_URL=http://127.0.0.1:3210
# TOKAI_SERVICE_PRIVATE_KEY=<generated base64 PKCS8 PEM, server-only>
# TOKAI_SERVICE_JWKS=<generated base64 public JWKS, deployed only to Convex auth config>
# TOKAI_SERVICE_ISSUER=http://localhost:4000
# TOKAI_SERVICE_KEY_ID=tokai-local-1
# TOKAI_JOB_SECRET=<generated internal callback credential>
# INTERNAL_API_URL=http://127.0.0.1:4000
API_ORIGIN=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
# Local accounts: infra/local/setup-identity.ts generates client/session secrets.
# OIDC_ISSUER=http://localhost:8088/realms/tokai-local
# OIDC_CLIENT_ID=tokai-web
# OIDC_CLIENT_SECRET=<server-only>
# SESSION_SECRET=<generated random value, at least32 characters>

# Resource limits are enforced durably in Convex. Set these on the Convex deployment;
# isolated FileStore tests read them from the API environment instead.
# TOKAI_MODEL_DAILY_UNITS=100
# TOKAI_MODEL_GLOBAL_DAILY_UNITS=400
# TOKAI_MODEL_CONCURRENCY=1
# TOKAI_MODEL_GLOBAL_CONCURRENCY=4
# Equivalent prefixes: TOKAI_SPEECH (Unicode characters), TOKAI_TRANSCRIPTION
# (milliseconds), TOKAI_INGESTION (bytes). Zero daily units disables new work.
# Optional metadata-only request/provider metrics, no lesson content:
# TOKAI_LOG_METRICS=1
# Optional dated USD rate table: configure on Convex for admission and API for matching estimates.
# See docs/phase-6-usage.md; use your actual model ID and current account rates.
# TOKAI_USAGE_RATES_JSON=
# Optional Convex-only decimal USD commitment caps; no monetary cap/rate is guessed or enabled.
# TOKAI_OWNER_DAILY_USD=
# TOKAI_GLOBAL_DAILY_USD=
# Required for dollar-capped storage; bounded raw-file retention, integer1..365.
# TOKAI_STORAGE_MAX_RETENTION_DAYS=
