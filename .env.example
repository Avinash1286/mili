# Phase 1 works without provider credentials in clearly labeled sample mode.
# Copy this file to .env in F:/mili. Never commit .env.
API_PORT=4000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional absolute path; default local storage is F:/mili/.tokai.
# TOKAI_DATA_DIR=F:/mili/.tokai

# Live text and voice. Keep both keys server-side.
GEMINI_API_KEY=
# Choose a model your account supports; validate with the explicit live probe.
GEMINI_MODEL=gemini-3.8-flash
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_VOICE_ID=aai-audrey
ASSEMBLYAI_STT_MODEL=universal-3-6-pro
